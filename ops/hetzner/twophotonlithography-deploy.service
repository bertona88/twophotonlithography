[Unit]
Description=Deploy twophotonlithography from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=CARGO_HOME=/root/.cargo
Environment=RUSTUP_HOME=/root/.rustup
ExecStart=/usr/local/sbin/twophotonlithography-deploy
Nice=10
IOSchedulingClass=idle
MemoryMax=3G
TimeoutStartSec=30min
